{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://voteassist.in/schema/knowledge-entry.schema.json",
  "title": "VoteAssist Knowledge Base Entry",
  "description": "A single curated, cited knowledge-base entry. Every entry must trace back to an official or clearly-labeled source. See docs/09-knowledge-base-schema.md for the full data model this implements.",
  "type": "object",
  "required": [
    "id",
    "topic",
    "title",
    "summary",
    "applicableStates",
    "sourceType",
    "sources",
    "lastVerifiedDate",
    "version",
    "reviewStatus",
    "language"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "topic": {
      "type": "string",
      "enum": [
        "registration", "correction", "shifting-of-residence", "deletion-objection",
        "epic", "ordinary-residence", "nri-voter", "service-voter", "pwd-voter",
        "qualifying-dates", "grievance", "polling-station", "roll-search", "glossary"
      ]
    },
    "title": { "type": "string" },
    "summary": { "type": "string", "maxLength": 500 },
    "body": { "type": "string", "description": "Markdown body, plain language, no legal advice framing" },
    "applicableStates": {
      "type": "array",
      "items": { "type": "string" },
      "description": "ISO-ish state/UT names, or the single value 'all' for nationwide procedures"
    },
    "sourceType": {
      "type": "string",
      "enum": ["eci_official", "state_ceo", "gazette_law", "sveep", "pib_release", "community_pending_verification"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "publisher": { "type": "string" }
        }
      }
    },
    "lastVerifiedDate": { "type": "string", "format": "date" },
    "version": { "type": "integer", "minimum": 1 },
    "relatedForms": {
      "type": "array",
      "items": { "type": "string", "enum": ["form-2", "form-6", "form-6a", "form-7", "form-8", "form-12d"] }
    },
    "relatedEntities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "language": { "type": "string", "description": "BCP-47 tag, e.g. en, hi" },
    "reviewStatus": {
      "type": "string",
      "enum": ["draft", "in_review", "verified", "needs_reverification"]
    },
    "caution": {
      "type": "string",
      "description": "Standard caution shown alongside the entry reminding users that portals/requirements can change and to confirm on the official site."
    }
  }
}
